# ============================================================
# Media Control Bot — 环境变量配置示例
# 复制此文件为 .env 并在 VPS 上填写实际值（切勿提交真实密钥到版本库）
# 建议权限：chmod 600 .env token.json
# ============================================================

# ── 1. 基础与权限配置（必填） ────────────────────────────────────

# Telegram Bot Token（必填，敏感；建议轮换任何曾暴露在日志中的旧 Token）
BOT_TOKEN=your_telegram_bot_token_here

# Telegram 唯一管理员用户 ID（必填，非零整数）
ADMIN_ID=123456789

# 媒体文件根目录（默认 /storage512/bilivego/download；所有文件操作均受此目录边界保护）
BASE_DIR=/storage512/bilivego/download

# 每页显示条目数（默认 8，必须 > 0）
ITEMS_PER_PAGE=8

# FFprobe 媒体探测超时时间（秒，默认 30，必须 > 0）
FFPROBE_TIMEOUT_SECONDS=30

# 文件在最近一次修改后至少安静的秒数；任务启动时还会复查两次元数据（0 表示关闭）
FILE_STABLE_SECONDS=30

# 删除文件在同一媒体盘回收站保留天数（1~365）
TRASH_RETENTION_DAYS=7

# ── 2. /storage512 磁盘监控与三级报警配置 ─────────────────────────
# 报警触发阈值已确认固化为：一级 >90%、二级 >95%、三级 >98%（严格大于）

# 目标存储独立挂载点（默认 /storage512；通过 /proc/self/mountinfo 核验真实挂载）
STORAGE_MOUNT_POINT=/storage512

# 后台定时巡检间隔秒数（默认 300 即 5 分钟；【待用户确认】）
DISK_CHECK_INTERVAL_SECS=300

# 三级报警滞后回落复位阈值百分比（默认 85 / 90 / 95；【待用户确认】）
DISK_ALERT_RESET_L1=85.0
DISK_ALERT_RESET_L2=90.0
DISK_ALERT_RESET_L3=95.0

# 磁盘报警跨重启去重状态文件（默认 ./.disk_alert_state.json，仅记录级别与挂载异常闩锁）
DISK_ALERT_STATE_FILE=./.disk_alert_state.json

# ── 3. RTMP 无损推流配置 ─────────────────────────────────────────
# 推流严格使用 -c copy 无损复刻，绝不重编码

# RTMP 推流地址（可选，敏感；不填则点击推流时提示未配置）
RTMP_URL=rtmp://your-rtmp-server/live/stream_key

# RTMP 网络读写超时秒数（默认 30；【待用户结合直播平台确认】）
RTMP_RW_TIMEOUT_SECS=30

# 源片总码率上行风险提示阈值（Mbps，默认 0.0 表示仅展示码率不弹风险提示；【待用户确认】）
RTMP_WARN_BITRATE_MBPS=0.0

# ── 4. YouTube 可恢复分块上传配置 ────────────────────────────────

# YouTube OAuth2 凭证文件路径（默认 ./token.json）
TOKEN_FILE=./token.json

# 最大并发上传数（代码默认保持 2；若部署在低配单核/小内存 VPS 建议改为 1）
YOUTUBE_MAX_CONCURRENT_UPLOADS=2

# 除并发运行任务外允许额外排队等待的最大任务数（默认 10；【待用户确认】）
YOUTUBE_MAX_QUEUE_SIZE=10

# 可恢复上传单次 HTTP PUT 真实分块大小（MB，默认 10，取值 1~64，恒满足 256 KiB 整数倍）
YOUTUBE_UPLOAD_CHUNK_MB=10

# 服务重启后的队列恢复策略（保守默认 none；可选 none | requeue | resume；【待用户确认】）
YOUTUBE_RECOVERY_MODE=none

# 启用 requeue / resume 时的队列持久化文件路径（默认 ./youtube_upload_queue.json，权限 0600）
YOUTUBE_UPLOAD_QUEUE_FILE=./youtube_upload_queue.json

# ── 5. 视频无损合并配置 ──────────────────────────────────────────
# 合并全流程严格禁止重编码（仅使用 -c copy 极速直连 / TS 中转重封装 / 可选有界片尾截除）

# 合并结果保留时长最低比例（默认 0.95，即至少保留输入总时长的 95%）
MERGE_MIN_DURATION_RATIO=0.95

# 合并结果体积辅助比对比例（默认 0.80；仅作为辅助诊断指标，不单独判定成功或失败）
MERGE_MIN_SIZE_RATIO=0.80

# 有界片尾无损截除探测上限秒数（默认 3，取值 0~60；【待用户确认】）
MERGE_MAX_LOSS_SECONDS=3

# 是否允许合并时自动启用有界片尾无损截除（保守默认 false：仅探测并提示候选秒数，不自动丢弃内容；【待用户确认】）
MERGE_ALLOW_AUTO_TRIM=false

# ── 6. 日志与脱敏配置 ────────────────────────────────────────────
# 所有日志流均经过全局敏感信息脱敏（自动屏蔽 BOT_TOKEN、RTMP 推流密钥、OAuth Token、上传会话签发参数）

# 日志级别过滤（默认 media_control_bot=info,teloxide=warn,hyper=warn）
RUST_LOG=media_control_bot=info,teloxide=warn,hyper=warn

# 日志输出格式（可选：pretty, json；默认 pretty）
LOG_FORMAT=pretty
