# ============================================================
# Media Control Bot — 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# Telegram Bot Token（必填）
BOT_TOKEN=your_telegram_bot_token_here

# Telegram 管理员用户 ID（必填，整数）
ADMIN_ID=123456789

# 媒体文件根目录（必填）
BASE_DIR=/storage512/bilivego/download

# RTMP 推流地址（可选，不填则推流功能不可用）
RTMP_URL=rtmp://your-rtmp-server/live/stream_key

# 每页显示条目数（默认 8）
ITEMS_PER_PAGE=8

# YouTube OAuth Token 文件路径（默认 ./token.json）
TOKEN_FILE=./token.json

# YouTube 最大并发上传数（默认 2）
YOUTUBE_MAX_CONCURRENT_UPLOADS=2

# YouTube 上传分块大小（MB，默认 10）
YOUTUBE_UPLOAD_CHUNK_MB=10

# 合并结果时长最低比例（默认 0.95，即 95%）
MERGE_MIN_DURATION_RATIO=0.95

# 合并结果体积最低比例（默认 0.30，即 30%）
MERGE_MIN_SIZE_RATIO=0.30

# 日志级别（可选：TRACE, DEBUG, INFO, WARN, ERROR，默认 INFO）
RUST_LOG=media_control_bot=info,teloxide=warn

# 日志格式（可选：pretty, json，默认 pretty）
LOG_FORMAT=pretty
